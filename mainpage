<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5">
<title>Học Phần Thưởng Thức: Tết 2027 | TH true JUICE milk YOUNG</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --red:#b51f2a;
  --red2:#d13a35;
  --green:#245c36;
  --gold:#d9a83d;
  --cream:#fff8eb;
  --ink:#26352b;
  --muted:#686e65;
  --line:#eadfca;
  --pink:#f9e9e3;
  --font-main:-apple-system,BlinkMacSystemFont,"SF Pro Text","SF Pro Display","Be Vietnam Pro","Roboto","Segoe UI",Arial,sans-serif;
}
*,*::before,*::after{
  box-sizing:border-box;
  font-family:var(--font-main);
  -webkit-tap-highlight-color:transparent;
}
html{
  scroll-behavior:smooth;
  -webkit-text-size-adjust:100%;
  text-size-adjust:100%;
}
body{
  margin:0;
  background:#fffdf8;
  color:var(--ink);
  font-size:15px;
  line-height:1.58;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
a{text-decoration:none;color:inherit}
button{font:inherit;cursor:pointer}
.wrap{width:min(1160px,calc(100% - 32px));margin:auto}

/* Top & Header */
.top{background:#245c36;color:#fff;font-size:11.5px;letter-spacing:.2px;font-weight:500}
.top .wrap{padding:7px 0;display:flex;justify-content:space-between;align-items:center;gap:8px}
.header{position:sticky;top:0;z-index:20;background:#fffdf8f5;backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav{min-height:64px;display:flex;align-items:center;gap:24px;padding:8px 0}

/* Logo & Placeholder */
.brand{display:inline-flex;align-items:center;flex-shrink:0}
.brand-logo{height:42px;width:auto;max-width:190px;object-fit:contain;display:block}
.logo-placeholder{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  height:42px;
  padding:0 14px;
  border:1.5px dashed #173e85;
  border-radius:8px;
  background:#f2f6fc;
  color:#173e85;
  font-size:11px;
  font-weight:800;
  letter-spacing:.4px;
  white-space:nowrap;
}

.links{margin-left:auto;display:flex;gap:22px;font-size:13px;font-weight:600;color:#4c594e}
.links a:hover{color:var(--red)}
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:46px;
  border:0;
  border-radius:10px;
  padding:12px 20px;
  background:var(--red);
  color:white;
  font-weight:700;
  font-size:14.5px;
  line-height:1.25;
  box-shadow:0 5px 14px #b9252724;
  transition:.18s;
}
.btn:hover{background:#941c20;transform:translateY(-1px)}
.btn:active{transform:scale(.98)}
.btn:disabled{opacity:.65;cursor:not-allowed;transform:none}
.btn.alt{background:#fff;color:var(--red);border:1px solid #e7c5b7;box-shadow:none}

/* Hero Feature */
.feature{position:relative;overflow:hidden;background:linear-gradient(180deg,#fff8eb 0%,#fffdf8 100%);padding:0 0 32px}
.feature>.wrap{width:100%;max-width:none}
.feature-head{width:min(1160px,calc(100% - 32px));position:relative;isolation:isolate;padding:28px 0 20px;text-align:center;margin:0 auto 14px}
.feature-head:before,.feature-head:after{position:absolute;z-index:-1;top:18px;color:#d99a45;opacity:.4;font-size:clamp(30px,5vw,60px);line-height:1;pointer-events:none}
.feature-head:before{content:"✿  ❀";left:2%;transform:rotate(-15deg)}
.feature-head:after{content:"❀  ✿";right:2%;transform:rotate(15deg)}
.kicker{font-size:11px;text-transform:uppercase;letter-spacing:1.6px;color:#a51e28;font-weight:800;line-height:1.35}
.feature h1,.section-head h2,.schedule-intro h3,.register-copy h2,.prize-copy h2,.form-card h3,.modal-card h3{
  color:var(--red);
  font-weight:800;
  letter-spacing:-0.02em;
}
.feature h1{font-size:clamp(25px,5.5vw,42px);line-height:1.18;margin:7px 0 9px}
.feature-head p{color:#5e675c;margin:0;font-size:14.5px}
.feature-image{display:block;width:100%;height:auto;max-height:none;object-fit:contain}
.feature-caption{width:min(1160px,calc(100% - 32px));display:flex;align-items:center;justify-content:space-between;gap:18px;margin:18px auto 0;color:#5e675c;font-size:13.5px}
.feature-caption strong{color:var(--green)}

/* Sections */
.section{padding:68px 0}
.section.tinted{background-color:#fff8ed;background-image:radial-gradient(circle at 7% 18%,#f5d8cf 0 2px,transparent 3px),radial-gradient(circle at 94% 82%,#f3dba9 0 2px,transparent 3px),linear-gradient(135deg,#fff8ed,#fffdf8 55%,#fff2e8)}
.section-head{max-width:700px;margin:0 auto 30px;text-align:center;position:relative}
.section-head:before,.section-head:after{content:"✿";position:absolute;color:#d99a45;opacity:.32;font-size:32px;top:6px}
.section-head:before{left:-8px}
.section-head:after{right:-8px}
.section-head .kicker{margin-bottom:6px}
.section-head h2{font-size:clamp(23px,5vw,35px);line-height:1.24;color:#a51e28;margin:0 0 10px}
.section-head p{margin:0;color:var(--muted);font-size:14.5px}

/* Schedule */
.schedule-layout{display:grid;grid-template-columns:.82fr 1.18fr;gap:28px;align-items:center}
.schedule-intro h3{font-size:22px;line-height:1.3;color:var(--red);margin:0 0 10px}
.schedule-intro p{color:var(--muted);margin:0 0 16px;font-size:14.5px}
.schedule-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:0 12px 35px #4b32100a;transition:.3s}
.schedule-card.updated{border-color:#4b9e5f;box-shadow:0 14px 40px #245c361a}
.schedule-title{display:flex;justify-content:space-between;align-items:center;gap:10px;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:12px;font-weight:800;font-size:13.5px;color:var(--green)}
.pill{background:#f9eee0;color:#9d5426;border-radius:99px;padding:5px 10px;font-size:11px;font-weight:700;white-space:nowrap;transition:.25s}
.pill.confirmed{background:#e4f4e7;color:#1d6b34;border:1px solid #b4dfc0}
.day{display:grid;grid-template-columns:62px 1fr;gap:10px;align-items:start;padding:7px 0}
.time{font-size:12px;color:#8c8b81;font-weight:700;padding-top:10px;font-variant-numeric:tabular-nums}
.event{background:#f8f2e8;border-left:3px solid #d7a74a;padding:10px 12px;border-radius:8px;font-size:13px;line-height:1.5}
.event b{display:block;color:#323f33;margin-bottom:3px;font-size:13.5px}
.event.special{background:#fcece8;border-left-color:var(--red)}
.event.special b{color:var(--red)}
.event.personal{background:#eef8ef;border-left:4px solid var(--green);animation:fadeInSlide .4s ease}
.event.personal b{color:var(--green)}
.personal-badge{display:inline-block;background:var(--green);color:#fff;font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;margin-bottom:4px;text-transform:uppercase;letter-spacing:.4px}
.schedule-note{font-size:11px;color:#969287;margin-top:10px}

@keyframes fadeInSlide{
  from{opacity:0;transform:translateY(-8px)}
  to{opacity:1;transform:translateY(0)}
}

/* Register */
.register-section{background:linear-gradient(135deg,#fff9ed,#fff2e9)}
.register-grid{display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:start}
.register-copy h2{font-size:clamp(24px,5vw,32px);line-height:1.24;color:var(--red);margin:6px 0 10px}
.register-copy p{color:var(--muted);margin:0;font-size:14.5px}
.steps{display:grid;gap:14px;margin-top:20px}
.step{display:flex;gap:12px;align-items:flex-start}
.num{flex:0 0 30px;height:30px;border-radius:9px;background:#b51f2a;color:#fff;display:grid;place-items:center;font-weight:800;font-size:12.5px;font-variant-numeric:tabular-nums;margin-top:2px}
.step b{display:block;color:var(--green);font-size:14.5px;margin-bottom:2px}
.step span{font-size:13px;color:var(--muted)}
.form-card{background:white;border:1px solid var(--line);border-top:4px solid var(--red);border-radius:18px;padding:22px;box-shadow:0 15px 40px #6c42120d}
.demo-label{display:inline-flex;align-items:center;gap:6px;background:#fff1e7;border:1px solid #f0d0c0;color:#9e2630;border-radius:999px;padding:5px 11px;font-size:11px;font-weight:800;margin:0 0 10px}
.demo-label:before{content:'✦';color:#c28a2e}
.form-card h3{margin:0 0 5px;color:var(--red);font-size:20px}
.form-card>p{margin:0 0 16px;color:var(--muted);font-size:13.5px}
.flavours{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:10px 0 16px}
.flavour{border:1.5px solid var(--line);background:#fffdf9;border-radius:12px;padding:11px 4px 9px;text-align:center;color:var(--ink);transition:.18s}
.flavour:hover,.flavour.active{border-color:var(--red);background:#fff4ee;box-shadow:0 4px 12px #b9252716}
.fruit{font-size:24px;display:block;margin-bottom:3px;line-height:1.2}
.flavour b{display:block;font-size:12px}
.flavour small{font-size:10px;color:var(--muted);display:block}
.selected{font-size:13px;background:#f7f3e9;border-radius:9px;padding:10px 12px;margin-bottom:14px;color:#5e6257}
.selected strong{color:var(--red)}
.field{margin:12px 0}
.field label{display:block;font-size:13px;font-weight:700;margin-bottom:6px}
.field input{
  width:100%;
  min-height:46px;
  border:1px solid #dfd3bd;
  border-radius:10px;
  padding:11px 13px;
  font-size:16px;
  outline:none;
  background:#fffefa;
  -webkit-appearance:none;
}
.field input:focus{border-color:var(--gold);box-shadow:0 0 0 3px #d9a83d22}
.form-card .btn{width:100%;margin-top:6px}
.fine{font-size:11px;color:#969287;margin-top:10px;line-height:1.45}

/* Confirm Box in Form */
.form-confirm{display:none;margin-top:16px;padding:15px;border-radius:12px;background:#eef8ef;border:1px solid #b8dfc0;color:var(--green)}
.form-confirm.show{display:block;animation:fadeInSlide .35s ease}
.form-confirm h4{margin:0 0 6px;font-size:15px;display:flex;align-items:center;gap:6px}
.form-confirm p{margin:0 0 12px;font-size:13px;color:#2f4735}
.form-confirm .mini-actions{display:flex;gap:8px;flex-wrap:wrap}
.btn-sm{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:8px 14px;font-size:12.5px;border-radius:8px;font-weight:700;border:0;background:var(--green);color:#fff}
.btn-sm.outline{background:#fff;color:var(--green);border:1px solid #9ecba8}

/* Prize & Lucky Wheel */
.prize-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:34px;align-items:center}
.prize-copy h2{font-size:clamp(24px,5vw,32px);line-height:1.24;color:var(--red);margin:6px 0 10px}
.prize-copy p{color:var(--muted);margin:0;font-size:14.5px}
.prizes{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}
.prize{border:1px solid var(--line);background:#fff;border-radius:12px;padding:13px;font-size:13px;transition:.25s;position:relative}
.prize-head{display:flex;align-items:flex-start;gap:7px;font-weight:800;color:var(--green);margin-bottom:5px;line-height:1.35;font-size:13.5px}
.prize-detail{font-size:12px;color:var(--muted);line-height:1.45}
.prize.won{border-color:var(--red);background:#fff3ef;box-shadow:0 6px 20px #b51f2a22;transform:translateY(-2px)}
.prize.won .prize-head{color:var(--red)}
.prize.won:after{content:"TRÚNG GIẢI";position:absolute;top:8px;right:8px;background:var(--red);color:#fff;font-size:9px;font-weight:800;padding:2px 6px;border-radius:4px}

/* Wheel Container + Pointer + Segment Labels */
.wheelbox{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px}
.wheel-wrapper{position:relative;width:320px;height:320px;display:grid;place-items:center}

.wheel-pointer{
  position:absolute;
  top:-14px;
  left:50%;
  transform:translateX(-50%);
  z-index:5;
  display:flex;
  flex-direction:column;
  align-items:center;
  filter:drop-shadow(0 4px 6px rgba(0,0,0,.25));
  pointer-events:none;
}
.wheel-pointer-cap{
  width:18px;
  height:18px;
  border-radius:50%;
  background:var(--gold);
  border:3px solid #fff;
  margin-bottom:-6px;
  z-index:2;
}
.wheel-pointer-arrow{
  width:0;
  height:0;
  border-left:14px solid transparent;
  border-right:14px solid transparent;
  border-top:28px solid var(--red);
}

.wheel{
  width:310px;
  height:310px;
  border-radius:50%;
  border:10px solid #fff;
  box-shadow:0 0 0 3px #d9a83d,0 16px 38px #6e391c2b;
  background:conic-gradient(
    #f9ded7 0deg 45deg,
    #fff1d2 45deg 90deg,
    #e5f0dc 90deg 135deg,
    #f9ded7 135deg 180deg,
    #fff1d2 180deg 225deg,
    #e5f0dc 225deg 270deg,
    #f9ded7 270deg 315deg,
    #fff1d2 315deg 360deg
  );
  position:relative;
  transition:transform 4s cubic-bezier(.15,.85,.22,1);
}

.wheel-lines{position:absolute;inset:0;border-radius:50%;overflow:hidden;pointer-events:none}
.wheel-line{
  position:absolute;
  top:0;
  left:50%;
  width:1px;
  height:50%;
  background:rgba(181,31,42,.18);
  transform-origin:bottom center;
}

.wheel-labels{position:absolute;inset:0;pointer-events:none}
.wheel-seg{
  position:absolute;
  top:0;
  left:50%;
  width:78px;
  height:50%;
  margin-left:-39px;
  transform-origin:bottom center;
  display:flex;
  flex-direction:column;
  align-items:center;
  padding-top:13px;
  text-align:center;
}
.wheel-seg .seg-icon{font-size:17px;line-height:1.1;margin-bottom:2px}
.wheel-seg .seg-text{
  font-size:9.5px;
  font-weight:800;
  line-height:1.15;
  color:var(--ink);
  max-width:68px;
}

.wheel-center{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  width:84px;
  height:84px;
  border-radius:50%;
  background:var(--red);
  border:4px solid #fff;
  box-shadow:0 4px 12px rgba(0,0,0,.22);
  color:#fff;
  font-weight:900;
  font-size:13px;
  display:grid;
  place-items:center;
  text-align:center;
  line-height:1.15;
  z-index:3;
  transition:.15s;
}
.wheel-center:hover{background:#941c20;transform:translate(-50%,-50%) scale(1.04)}
.wheel-center:active{transform:translate(-50%,-50%) scale(.96)}
.wheel-hint{font-size:12.5px;color:var(--muted);text-align:center;max-width:300px}

/* Stores & Footer */
.stores{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}
.store{background:#fff;border:1px solid var(--line);border-radius:13px;padding:18px;display:flex;flex-direction:column}
.store strong{font-size:16.5px;color:var(--green);margin-bottom:5px}
.store p{font-size:12.5px;color:var(--muted);margin:0 0 12px;flex:1}
.store a{font-size:12.5px;color:var(--red);font-weight:800;display:inline-block;padding:4px 0}
.note{text-align:center;font-size:11px;color:#999487;margin-top:18px}
.footer{background:#214b32;color:#fff;padding:26px 0}
.footer .wrap{display:flex;justify-content:space-between;align-items:center;gap:16px}
.footer small{color:#d4e0d2;font-size:12px}

/* Modal */
.modal{position:fixed;inset:0;background:#1c241dbb;display:none;align-items:center;justify-content:center;padding:18px;z-index:30}
.modal.show{display:flex}
.modal-card{background:#fffdf8;border-radius:18px;padding:24px 20px;max-width:400px;width:100%;text-align:center;border:1px solid #ead7b2;box-shadow:0 20px 50px rgba(0,0,0,.25)}
.modal-card h3{color:var(--green);margin:6px 0 8px;font-size:21px;line-height:1.28}
.modal-card p{color:var(--muted);font-size:14px;margin:0 0 14px}
.modal-card .btn{width:100%}

/* ================= MOBILE OPTIMIZATION ================= */
@media(max-width:820px){
  .wrap{width:calc(100% - 28px)}
  .top .wrap{font-size:11px;padding:6px 0}
  .nav{min-height:56px;padding:8px 0;gap:8px;flex-wrap:wrap}
  .brand-logo{height:36px;max-width:160px}
  .logo-placeholder{height:36px;padding:0 11px;font-size:10.5px}
  .nav>.btn{
    margin-left:auto;
    min-height:36px;
    padding:7px 13px;
    font-size:12.5px;
    border-radius:8px;
  }
  .links{
    order:3;
    width:100%;
    overflow-x:auto;
    gap:8px;
    padding:4px 0 2px;
    scrollbar-width:none;
    -webkit-overflow-scrolling:touch;
  }
  .links::-webkit-scrollbar{display:none}
  .links a{
    white-space:nowrap;
    font-size:12px;
    padding:5px 11px;
    border-radius:999px;
    background:#f7f1e5;
    color:#3f4d41;
  }

  /* Hero mobile */
  .feature{padding:0 0 26px}
  .feature-head{width:calc(100% - 28px);padding:20px 0 14px;margin-bottom:10px}
  .feature-head:before,.feature-head:after{display:none}
  .feature-caption{width:calc(100% - 28px);display:block;margin-top:14px;font-size:13.5px}
  .feature-caption .btn{width:100%;margin-top:14px}

  /* Section & Layout 1 cột cho mobile */
  .section{padding:44px 0}
  .section-head{margin-bottom:22px}
  .section-head:before,.section-head:after{display:none}
  .schedule-layout,.register-grid,.prize-grid{grid-template-columns:1fr;gap:22px}

  .prize-grid .wheelbox{order:-1;margin-bottom:6px}
  .prize-copy .btn{width:100%}
  .schedule-intro .btn{width:100%}

  /* Schedule mobile */
  .schedule-card{padding:16px;border-radius:14px}
  .schedule-title{flex-wrap:wrap;gap:6px;font-size:13px}
  .day{grid-template-columns:46px 1fr;gap:8px}
  .time{font-size:11.5px}
  .event{padding:9px 11px;font-size:12.5px}

  /* Form & 5 hương vị lướt ngang đều 1 hàng trên mobile */
  .form-card{padding:18px 16px;border-radius:16px}
  .flavours{
    display:flex;
    overflow-x:auto;
    gap:8px;
    padding-bottom:4px;
    scroll-snap-type:x mandatory;
    scrollbar-width:none;
    -webkit-overflow-scrolling:touch;
  }
  .flavours::-webkit-scrollbar{display:none}
  .flavour{
    flex:0 0 82px;
    scroll-snap-align:start;
    padding:10px 4px 8px;
  }
  .form-confirm .mini-actions{flex-direction:column}
  .btn-sm{width:100%}

  /* Prizes & Stores 1 cột dễ đọc trên điện thoại */
  .prizes{grid-template-columns:1fr;gap:9px}
  .stores{grid-template-columns:1fr;gap:10px}
  .store{padding:15px}
  .store p{min-height:auto;margin-bottom:8px}

  /* Footer mobile */
  .footer{padding:22px 0;text-align:center}
  .footer .wrap{display:block}
  .footer small{display:block;margin-top:6px}
}

@media(max-width:390px){
  .wheel-wrapper{width:280px;height:280px}
  .wheel{width:270px;height:270px;border-width:8px}
  .wheel-seg{width:68px;margin-left:-34px;padding-top:11px}
  .wheel-seg .seg-icon{font-size:15px}
  .wheel-seg .seg-text{font-size:8.5px;max-width:58px}
  .wheel-center{width:76px;height:76px;font-size:12px}
}
</style>
</head>
<body>

<div class="top"><div class="wrap"><span>TH true JUICE milk YOUNG</span><span>HỌC PHẦN TẾT · XUÂN 2027</span></div></div>
<header class="header">
  <div class="wrap nav">
    <!-- THAY "logo-th.png" BẰNG LINK HOẶC TÊN FILE ẢNH LOGO CỦA BẠN -->
    <a class="brand" href="#home" aria-label="Trang chủ">
      <img
        class="brand-logo"
        src="https://uploads.onecompiler.io/45a273ayv/45a27b9ht/LOGO%20TH%20TRUE%20JUICE%20MILK_NGANG.png"
        alt="Logo TH"
        onerror="this.style.display='none'; document.getElementById('logoPlaceholder').style.display='inline-flex';"
      >
      <span class="logo-placeholder" id="logoPlaceholder" style="display:none">CHÈN ẢNH LOGO TH</span>
    </a>

    <nav class="links">
      <a href="#home">Trang chủ</a>
      <a href="#thoi-khoa-bieu">Thời khóa biểu</a>
      <a href="#dang-ky">Đăng ký</a>
      <a href="#qua-tang">Quay thưởng</a>
      <a href="#diem-ban">Điểm bán</a>
    </nav>
    <a class="btn alt" href="#dang-ky">Tham gia</a>
  </div>
</header>

<main id="home">
  <!-- HERO -->
  <section class="feature">
