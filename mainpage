<script>
// 1. Xử lý chọn hương vị & Đăng ký cập nhật Thời khóa biểu
const flavours = document.querySelectorAll('.flavour');
const chosen = document.getElementById('chosen');
let currentFlavour = 'Dâu Tự Nhiên';
let currentMoment = 'Khai Xuân Ngọt Ngào (08:30)';

flavours.forEach(btn => {
  btn.addEventListener('click', () => {
    flavours.forEach(x => x.classList.remove('active'));
    btn.classList.add('active');
    currentFlavour = btn.dataset.name;
    currentMoment = btn.dataset.moment;
    chosen.textContent = currentFlavour;
    btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
  });
});

const regForm = document.getElementById('regForm');
const formConfirm = document.getElementById('formConfirm');
const confirmText = document.getElementById('confirmText');
const personalScheduleSlot = document.getElementById('personalScheduleSlot');
const schedulePill = document.getElementById('schedulePill');
const scheduleCard = document.getElementById('scheduleCard');

regForm.addEventListener('submit', e => {
  e.preventDefault();
  const name = document.getElementById('userName').value.trim();
  const phone = document.getElementById('userPhone').value.trim();
  const regCode = 'THTET-' + Math.floor(1000 + Math.random() * 9000);

  confirmText.innerHTML = `Chào <strong>${name}</strong> (SĐT: ${phone})! Mã học phần của bạn là <strong>${regCode}</strong> với vị <strong>${currentFlavour}</strong>. Lịch thưởng thức của bạn đã được cập nhật ở Trạm 01.`;
  formConfirm.classList.add('show');

  schedulePill.textContent = `Đã đăng ký · ${regCode}`;
  schedulePill.classList.add('confirmed');
  scheduleCard.classList.add('updated');

  personalScheduleSlot.innerHTML = `
    <div class="day">
      <div class="time">CÁ NHÂN</div>
      <div class="event personal">
        <span class="personal-badge">✓ Đã ghi danh · ${regCode}</span>
        <b>Học phần của ${name}: TH true JUICE milk YOUNG ${currentFlavour}</b>
        <span>Gợi ý khung giờ vàng: ${currentMoment}. Xuất trình mã ${regCode} tại TH true mart để nhận ưu đãi.</span>
      </div>
    </div>
  `;

  document.getElementById('submitRegBtn').textContent = 'Cập nhật lại thông tin đăng ký';
  formConfirm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
});

// 2. Xử lý Vòng quay trúng thưởng
const segments = [
  { wheelLabel: 'Lốc 5 vị Ngũ quả', fullName: 'Lốc 5 vị "Ngũ quả tự thưởng"', icon: '🎁', detailIndex: 0, desc: 'Trọn bộ 1 lốc TH true JUICE milk YOUNG (mix đủ 5 vị), đổi trực tiếp tại TH true mart và các điểm bán.' },
  { wheelLabel: 'Voucher 50K', fullName: 'Voucher 50.000đ', icon: '🎫', detailIndex: 1, desc: 'Mã giảm 50.000đ cho đơn từ 150.000đ tại TH true mart & app TH eLIFE.' },
  { wheelLabel: 'Bao Lì Xì Tết', fullName: 'Bộ Bao Lì Xì Tết', icon: '🧧', detailIndex: 2, desc: 'Set 10 bao lì xì thiết kế độc quyền "Học Phần Tết 2027" in ép kim sang trọng.' },
  { wheelLabel: 'Combo 3 chai', fullName: 'Combo 3 chai "Khai sảnh đổi mood"', icon: '🥤', detailIndex: 3, desc: 'Tặng ngay 01 vị bất kì khi mua 02 hộp (180ml) tại quầy trải nghiệm Học Phần Tết.' },
  { wheelLabel: 'Voucher 50K', fullName: 'Voucher 50.000đ', icon: '🎫', detailIndex: 1, desc: 'Mã giảm 50.000đ cho đơn từ 150.000đ tại TH true mart & app TH eLIFE.' },
  { wheelLabel: 'Bao Lì Xì Tết', fullName: 'Bộ Bao Lì Xì Tết', icon: '🧧', detailIndex: 2, desc: 'Set 10 bao lì xì thiết kế độc quyền "Học Phần Tết 2027" in ép kim sang trọng.' },
  { wheelLabel: 'Combo 3 chai', fullName: 'Combo 3 chai "Khai sảnh đổi mood"', icon: '🥤', detailIndex: 3, desc: 'Tặng ngay 01 vị bất kì khi mua 02 hộp (180ml) tại quầy trải nghiệm Học Phần Tết.' },
  { wheelLabel: 'Voucher 50K', fullName: 'Voucher 50.000đ', icon: '🎫', detailIndex: 1, desc: 'Mã giảm 50.000đ cho đơn từ 150.000đ tại TH true mart & app TH eLIFE.' }
];

const wheel = document.getElementById('wheel');
const wheelLines = document.getElementById('wheelLines');
const wheelLabels = document.getElementById('wheelLabels');
const spinBtn = document.getElementById('spinBtn');
const wheelCenterBtn = document.getElementById('wheelCenterBtn');
const wheelHint = document.getElementById('wheelHint');
const prizeCards = document.querySelectorAll('#prizeDetailsList .prize');

const modal = document.getElementById('modal');
const modalTitle = document.getElementById('modalTitle');
const modalBody = document.getElementById('modalBody');

const sliceDeg = 360 / segments.length;
segments.forEach((seg, i) => {
  const line = document.createElement('div');
  line.className = 'wheel-line';
  line.style.transform = `rotate(${i * sliceDeg}deg)`;
  wheelLines.appendChild(line);

  const label = document.createElement('div');
  label.className = 'wheel-seg';
  label.style.transform = `rotate(${i * sliceDeg + sliceDeg / 2}deg)`;
  label.innerHTML = `<span class="seg-icon">${seg.icon}</span><span class="seg-text">${seg.wheelLabel}</span>`;
  wheelLabels.appendChild(label);
});

let currentRotation = 0;
let isSpinning = false;

function handleSpin() {
  if (isSpinning) return;
  isSpinning = true;
  spinBtn.disabled = true;
  wheelCenterBtn.disabled = true;
  wheelHint.textContent = 'Đang quay... Chúc bạn rước lộc đầu xuân!';

  prizeCards.forEach(c => c.classList.remove('won'));

  const winIndex = Math.floor(Math.random() * segments.length);
  const wonSeg = segments[winIndex];

  const targetCenterAngle = winIndex * sliceDeg + sliceDeg / 2;
  const stopAngle = (360 - targetCenterAngle) % 360;
  const currentMod = ((currentRotation % 360) + 360) % 360;
  const delta = (stopAngle - currentMod + 360) % 360;

  currentRotation += 1800 + delta;
  wheel.style.transform = `rotate(${currentRotation}deg)`;

  setTimeout(() => {
    isSpinning = false;
    spinBtn.disabled = false;
    wheelCenterBtn.disabled = false;

    const matchedCard = document.querySelector(`.prize[data-prize-index="${wonSeg.detailIndex}"]`);
    if (matchedCard) matchedCard.classList.add('won');

    wheelHint.innerHTML = `Mũi tên chỉ trúng: <strong>${wonSeg.icon} ${wonSeg.fullName}</strong>`;
    modalTitle.textContent = `Trúng ${wonSeg.fullName}!`;
    modalBody.textContent = `${wonSeg.desc} Vui lòng kiểm tra phần chi tiết đã được đánh dấu bên dưới vòng quay.`;
    modal.classList.add('show');
  }, 4100);
}

spinBtn.addEventListener('click', handleSpin);
wheelCenterBtn.addEventListener('click', handleSpin);
document.getElementById('closeModal').addEventListener('click', () => modal.classList.remove('show'));
</script>
